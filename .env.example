# Environment Configuration 🛠️

# Database: PostgreSQL connection string (e.g., Neon, Supabase, or Local)
PURUBOY_PG_URL="postgres://user:password@host:port/db?sslmode=require"

# Security: Secret key for /api/admin access
PURUBOY_ADMIN_KEY="your_secure_admin_key_here"

# AI Provider: Personal DeepSeek User ID (Bearer Token from chat.deepseek.com)
# Required only if using direct web-client endpoints
DEEPSEEK_USER_ID="your_deepseek_token"

# AI Provider: Puru (HF Space, OpenAI-compatible). Model 'puru' di
# /api/chat/completions memakai upstream HF Space model 'puru'.
PURUBOY_PURU_BASE_URL="https://nirkyy-a.hf.space/v1"
PURUBOY_PURU_API_KEY="sk-843e3f05f05eacfe-55n2je-f2c2b844"

# Optional: Port configuration (Default: 8080)
PORT=8080

# Frontend -> backend: override backendUrl di config.json (build-time, opsional)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8081"

# Backend Go: token GitHub opsional untuk pages/user-scripts/skills (rate limit API)
GITHUB_TOKEN=""

# Backend Go: proxy fallback Cloudflare untuk scraper (opsional)
CF_PROXY="https://vercel-api-beta-red.vercel.app/api/fetch"

# Optional: Base URL Background HTTP Job proxy (default: https://nirkyy-a.hf.space)
# Dipakai untuk offload job lama (misal text2image) agar tidak kena timeout Vercel.
PROXY_JOB_BASE="https://nirkyy-a.hf.space"

# Optional: Base URL publik API ini (default: https://puruboy-api.vercel.app)
# Dipakai worker callback dari proxy. Di Vercel otomatis dari VERCEL_URL.
SERVER_BASE="https://puruboy-api.vercel.app"