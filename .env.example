# Environment Configuration 🛠️

# Database: PostgreSQL connection string (e.g., Neon, Supabase, or Local)
PURUBOY_PG_URL="postgres://user:password@host:port/db?sslmode=require"

# Security: Secret key for /api/admin access
PURUBOY_ADMIN_KEY="your_secure_admin_key_here"

# AI Provider: Personal DeepSeek User ID (Bearer Token from chat.deepseek.com)
# Required only if using direct web-client endpoints
DEEPSEEK_USER_ID="your_deepseek_token"

# Optional: Port configuration (Default: 8080)
PORT=8080